// YasCareer — Prisma schema (PostgreSQL)
// Ported 1:1 from the original AdonisJS/Lucid migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  rh
  candidat
  superviseur
}

enum InterviewRequestStatus {
  en_attente
  disponible
  indisponible
}

enum ContractType {
  stage
  cdd
  cdi
}

enum EmploiStatus {
  actif
  termine
}

enum SupervisionNoteType {
  rapport
  evaluation
  observation
}

enum OfferType {
  stage
  emploi
}

enum OfferStatus {
  brouillon
  publiee
  fermee
}

enum ApplicationStatus {
  envoyee
  en_cours_analyse
  preselectionnee
  entretien_programme
  entretien_realise
  acceptee
  rejetee
}

enum InterviewMode {
  presentiel
  distanciel
}

enum InterviewStatus {
  planifie
  termine
  annule
}

enum ChatRole {
  user
  assistant
}

model User {
  id                 Int       @id @default(autoincrement())
  fullName           String?   @map("full_name")
  email              String    @unique @db.VarChar(254)
  password           String
  role               UserRole  @default(candidat)
  phone              String?   @db.VarChar(30)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  // Département de rattachement — utilisé pour les superviseurs, afin de ne
  // proposer que les superviseurs du département de l'offre lors de la
  // programmation groupée des entretiens. Nullable : ne concerne pas les
  // autres rôles et ne casse aucune donnée existante.
  departementId      Int?      @map("departement_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  departement      Departement?               @relation(fields: [departementId], references: [id], onDelete: SetNull)
  profile          CandidateProfile?
  applications     Application[]
  notifications    Notification[]
  offers           Offer[]                    @relation("OfferCreator")
  statusChanges    ApplicationStatusHistory[] @relation("StatusChanger")
  activityLogs     ActivityLog[]
  chatbotMessages  ChatbotMessage[]

  supervisedInterviews          Interview[]        @relation("InterviewSupervisor")
  interviewRequestsAsSupervisor InterviewRequest[]  @relation("InterviewRequestSupervisor")
  interviewRequestsRequested    InterviewRequest[]  @relation("InterviewRequestRequester")
  emploisAsCollaborateur        Emploi[]            @relation("EmploiCollaborateur")
  emploisSupervised             Emploi[]            @relation("EmploiSupervisor")
  supervisionNotesAuthored      SupervisionNote[]   @relation("SupervisionNoteAuthor")
  applicationNotesAuthored      ApplicationNote[]   @relation("ApplicationNoteAuthor")
  candidateDocuments            CandidateDocument[]

  @@map("users")
}

model CandidateProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  bio             String?
  skills          String?
  anneesEtude     String?   @map("annees_etude")
  ville           String?
  quartier        String?
  cvUrl           String?   @map("cv_url")
  aiExtractedData Json?     @map("ai_extracted_data")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model Offer {
  id                 Int         @id @default(autoincrement())
  title              String
  type               OfferType
  description        String
  requirements       String?
  deadline           DateTime?
  location           String?
  status             OfferStatus @default(brouillon)
  aiAnalysisCriteria String?     @map("ai_analysis_criteria")
  // Tableau JSON structuré : [{ nom, obligatoire, description? }] — documents
  // complémentaires définis par le RH (CV/Lettre restent universels, gérés
  // séparément, jamais dans cette liste). Les offres créées avant cette
  // structuration ont été migrées avec obligatoire=true pour chaque entrée.
  documentsRequis    Json        @default("[]") @map("documents_requis")
  // Nullable en base pour ne pas forcer de migration sur les offres déjà
  // créées ; le caractère obligatoire est appliqué à l'écriture (Zod +
  // formulaire), pour toute nouvelle création/modification d'offre.
  departementId      Int?        @map("departement_id")
  createdBy          Int         @map("created_by")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime?   @updatedAt @map("updated_at")

  creator      User          @relation("OfferCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  departement  Departement?  @relation(fields: [departementId], references: [id], onDelete: SetNull)
  applications Application[]

  @@map("offers")
}

// Rattachement hiérarchique simple : Département → Offre → Candidatures.
// Pas de gestion CRUD dédiée pour l'instant — juste la relation et la
// sélection à la création/modification d'une offre.
model Departement {
  id          Int      @id @default(autoincrement())
  nom         String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  offers      Offer[]
  supervisors User[]

  @@map("departements")
}

model Application {
  id              Int               @id @default(autoincrement())
  offerId         Int               @map("offer_id")
  userId          Int               @map("user_id")
  cvUrl           String?           @map("cv_url")
  coverLetterUrl  String?           @map("cover_letter_url")
  coverLetterText String?           @map("cover_letter_text")
  documentsUrls   Json?             @map("documents_urls")
  status          ApplicationStatus @default(envoyee)
  aiMatchScore    Int?              @map("ai_match_score")
  aiSummary       String?           @map("ai_summary")
  aiAnalyzedAt    DateTime?         @map("ai_analyzed_at")
  aiAnalysisData  Json?             @map("ai_analysis_data")
  appliedAt       DateTime          @map("applied_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime?         @updatedAt @map("updated_at")

  offer         Offer                      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusHistory ApplicationStatusHistory[]
  notes         ApplicationNote[]
  interview     Interview?
  interviewRequests InterviewRequest[]
  emploi        Emploi?
  supervisionNotes  SupervisionNote[]

  @@unique([offerId, userId])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            Int       @id @default(autoincrement())
  applicationId Int       @map("application_id")
  status        String
  note          String?
  changedBy     Int?      @map("changed_by")
  changedAt     DateTime  @map("changed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changer     User?       @relation("StatusChanger", fields: [changedBy], references: [id], onDelete: SetNull)

  @@map("application_status_histories")
}

// Documents permanents du candidat (diplômes, certifications, attestations,
// CV/lettre de motivation "type") — libellé libre, réutilisés lors des
// candidatures par simple correspondance de texte avec `Offer.documentsRequis`.
model CandidateDocument {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  label     String
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("candidate_documents")
}

model ApplicationNote {
  id            Int       @id @default(autoincrement())
  applicationId Int       @map("application_id")
  authorId      Int       @map("author_id")
  content       String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation("ApplicationNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_notes")
}

model Interview {
  id              Int             @id @default(autoincrement())
  applicationId   Int             @unique @map("application_id")
  supervisorId    Int?            @map("supervisor_id")
  scheduledAt     DateTime        @map("scheduled_at")
  durationMinutes Int             @default(30) @map("duration_minutes")
  location        String?         @map("location")
  meetingLink     String?         @map("meeting_link")
  mode            InterviewMode   @default(distanciel)
  status          InterviewStatus @default(planifie)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime?       @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  supervisor  User?       @relation("InterviewSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  @@map("interviews")
}

model InterviewRequest {
  id               Int                     @id @default(autoincrement())
  // Nullable : une demande peut concerner une candidature précise (ancien
  // flux, conservé) OU être générique — une simple collecte de disponibilité
  // auprès d'un superviseur, sans candidat associé pour l'instant (nouveau
  // flux "Demander les disponibilités" depuis la page Entretiens).
  applicationId    Int?                    @map("application_id")
  supervisorId     Int                     @map("supervisor_id")
  requestedBy      Int                     @map("requested_by")
  status           InterviewRequestStatus  @default(en_attente)
  // Message professionnel rédigé par le RH à la création (demande générique),
  // persisté pour que le superviseur puisse le relire une fois connecté —
  // l'email envoyé à l'ouverture ne fait que renvoyer vers l'application.
  message          String?                 @db.Text
  availabilityNote String?                 @map("availability_note")
  // Double usage, réutilisé plutôt que dupliqué : au moment de l'envoi, ce
  // sont les créneaux PROPOSÉS par le RH (tableau JSON de { date, start,
  // end }) ; une fois que le superviseur répond, ce même champ est écrasé
  // par le sous-ensemble qu'il CONFIRME comme disponible.
  availableSlots   Json?                   @map("available_slots")
  respondedAt      DateTime?               @map("responded_at")
  // Renseigné quand le RH a fini de traiter la réponse (généralement : au
  // moment où il programme l'entretien à partir d'un créneau confirmé) —
  // fait disparaître la demande de l'onglet "À traiter".
  handledAt        DateTime?               @map("handled_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime?               @updatedAt @map("updated_at")

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  supervisor  User         @relation("InterviewRequestSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)
  requester   User         @relation("InterviewRequestRequester", fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([supervisorId])
  @@map("interview_requests")
}

model Emploi {
  id           Int          @id @default(autoincrement())
  applicationId Int         @unique @map("application_id")
  userId       Int          @map("user_id")
  supervisorId Int          @map("supervisor_id")
  department   String?
  contractType ContractType @map("contract_type")
  startDate    DateTime     @map("start_date")
  endDate      DateTime?    @map("end_date")
  status       EmploiStatus @default(actif)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime?    @updatedAt @map("updated_at")

  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user             User              @relation("EmploiCollaborateur", fields: [userId], references: [id], onDelete: Cascade)
  supervisor       User              @relation("EmploiSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)
  supervisionNotes SupervisionNote[]

  @@index([supervisorId])
  @@index([userId])
  @@map("emplois")
}

model SupervisionNote {
  id        Int                 @id @default(autoincrement())
  // Exactement l'un des deux est renseigné : emploiId pour le suivi/évaluation
  // d'un collaborateur déjà recruté, applicationId pour l'évaluation d'un
  // entretien avant toute décision d'embauche (pas encore de dossier Emploi).
  emploiId      Int?    @map("emploi_id")
  applicationId Int?    @map("application_id")
  authorId      Int     @map("author_id")
  type          SupervisionNoteType
  title         String?
  content       String
  rating        Int?
  // Uniquement pour une évaluation d'entretien (type "evaluation" +
  // applicationId) : favorable | a_revoir | defavorable.
  recommendation String?
  // Chemin (/uploads/...) du PDF récapitulatif, généré au moment de l'envoi
  // de l'évaluation (pas à la demande de téléchargement).
  fichierRapport String?          @map("fichier_rapport")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime?           @updatedAt @map("updated_at")

  emploi      Emploi?      @relation(fields: [emploiId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User         @relation("SupervisionNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([emploiId])
  @@index([applicationId])
  @@map("supervision_notes")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  content   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ChatbotMessage {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  role      ChatRole
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("chatbot_messages")
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  action       String   @db.VarChar(80)
  category     String   @default("general") @db.VarChar(40)
  summary      String   @db.VarChar(500)
  resourceType String?  @map("resource_type") @db.VarChar(60)
  resourceId   Int?     @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@index([category])
  @@map("activity_logs")
}
