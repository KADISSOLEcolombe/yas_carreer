# ================= YasCareer API (backend) =================

# ---- Base de données (requis) ----
# PostgreSQL — adaptez à votre instance (Neon, Supabase, RDS, VPS aaPanel…)
DATABASE_URL="postgresql://yascareer:password@localhost:5432/yascareer?schema=public"

# ---- Secret application (requis) ----
# Signe les JWT et les tokens d'activation HMAC. CHANGEZ-LA en production.
APP_KEY="remplacez-par-une-chaine-aleatoire-longue-et-secrete"

# ---- Frontend ----
# Origine du frontend séparé. Sert à deux choses :
#  1) les en-têtes CORS (le front appelle cette API depuis une autre origine)
#  2) les liens d'activation de compte envoyés par email
FRONTEND_URL="http://localhost:3000"

# ---- IA : Ollama auto-hébergé (optionnel — fallback heuristique si absent) ----
# Endpoint OpenAI-compatible d'Ollama. Local : http://localhost:11434/v1
# Autre serveur (réseau privé recommandé) : http://10.0.0.X:11434/v1
OLLAMA_URL="http://localhost:11434/v1"
# Modèle chargé dans Ollama (ex. : ollama pull llama3.1)
OLLAMA_MODEL="llama3.1"
# Optionnel : jeton si Ollama est derrière un proxy d'authentification
OLLAMA_API_KEY=""

# ---- Recherche web candidats (optionnel — DuckDuckGo par défaut) ----
TAVILY_API_KEY=""
SERPER_API_KEY=""

# ---- Email (optionnel — logué en console si absent) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="YasCareer <no-reply@yascareer.tg>"
