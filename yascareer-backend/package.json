{
  "name": "yascareer-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API YasCareer (recrutement Yas Togo) — Next.js Route Handlers + Prisma + PostgreSQL + Ollama",
  "scripts": {
    "dev": "next dev -p 3333",
    "build": "prisma generate && next build",
    "start": "next start -p 3333",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "next": "15.5.22",
    "nodemailer": "^9.0.4",
    "openai": "^5.12.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
