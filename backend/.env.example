# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# IA
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend (liens email activation / suivi)
FRONTEND_URL=http://localhost:3000

# Recherche web candidats (optionnel — sinon DuckDuckGo)
# Tavily: https://tavily.com — recommandé pour l'IA
TAVILY_API_KEY=
# Serper (Google): https://serper.dev
SERPER_API_KEY=

# Email (optionnel en local)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=YasCareer <noreply@yascareer.tg>

# MySQL (prod) — en local le projet utilise SQLite (tmp/db.sqlite3)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_DATABASE=yascareer