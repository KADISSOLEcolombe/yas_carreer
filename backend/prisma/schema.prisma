generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  id                                                 Int                  @id(map: "pk_utilisateur") @default(autoincrement())
  dep_id                                             Int?
  mot_de_passe                                       String               @db.VarChar(255)
  email                                              String               @unique(map: "index_utilisateur_email") @db.VarChar(150)
  prenom                                             String               @db.VarChar(100)
  telephone                                          String               @db.VarChar(20)
  quartier                                           String               @db.VarChar(100)
  type                                               String               @db.VarChar(50)
  supprime                                           Boolean?
  nom                                                String               @db.VarChar(100)
  sexe                                               String?              @db.VarChar(20)
  ville                                              String?              @db.VarChar(100)
  annees_experience                                  Int?
  niveau_etude                                       String?              @db.VarChar(50)
  domaine_etudes                                     String?              @db.VarChar(100)
  candidature                                        Candidature[]
  entretien_entretien_utilisateurrh_idToutilisateur  Entretien[]          @relation("entretien_utilisateurrh_idToutilisateur")
  entretien_entretien_utilisateursup_idToutilisateur Entretien[]          @relation("entretien_utilisateursup_idToutilisateur")
  evaluation                                         Evaluation[]
  favori                                             favori[]
  historique_statut                                  historique_statut[]
  notification                                       notification[]
  offre                                              Offre[]
  departement                                        Departement?         @relation(fields: [dep_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_utilisat_reference_departem")
  utilisateur_profil                                 utilisateur_profil[]

  @@map("utilisateur")
}

model Departement {
  id          Int           @id(map: "pk_departement") @default(autoincrement())
  nom         String        @unique(map: "index_unique_nom") @db.VarChar(100)
  description String
  supprime    Boolean?
  emplois     Emploi[]
  offre       Offre[]
  utilisateur Utilisateur[]

  @@map("departement")
}

model Offre {
  id                Int           @id(map: "pk_offre") @default(autoincrement())
  dep_id            Int
  titre             String        @db.VarChar(150)
  date_publication  DateTime      @db.Date
  exigence          String
  date_limite       DateTime      @db.Date
  localisation      String        @db.VarChar(100)
  utilisateurrh_id  Int
  type              String        @db.VarChar(50)
  exigences_fichier String        @db.VarChar(1000)
  supprime          Boolean?
  statut            String?       @default("BROUILLON") @db.VarChar(50)
  candidatures      Candidature[]
  favori            favori[]
  departement       Departement   @relation(fields: [dep_id], references: [id], onUpdate: Restrict, map: "fk_offre_reference_departem")
  utilisateur       Utilisateur   @relation(fields: [utilisateurrh_id], references: [id], onUpdate: Restrict, map: "fk_offre_reference_utilisat")

  @@map("offre")
}

model Candidature {
  id                 Int                 @id(map: "pk_candidature") @default(autoincrement())
  score              Int?
  date_soumission    DateTime            @db.Date
  statut             String              @db.VarChar(50)
  id_offre           Int
  utilisateurcand_id Int
  supprime           Boolean?
  utilisateur        Utilisateur         @relation(fields: [utilisateurcand_id], references: [id], onUpdate: Restrict, map: "fk_candidat_reference_utilisat")
  offre              Offre               @relation(fields: [id_offre], references: [id], onUpdate: Restrict, map: "fk_candidature_offre")
  emploi             Emploi[]
  entretiens         Entretien[]
  fichier            fichier[]
  historique_statut  historique_statut[]

  @@map("candidature")
}

model Entretien {
  id                                                   Int          @id(map: "pk_entretien") @default(autoincrement())
  date                                                 DateTime     @db.Date
  type                                                 String       @db.VarChar(50)
  statut                                               String       @db.VarChar(50)
  commentaire                                          String?
  id_candidature                                       Int
  utilisateurrh_id                                     Int
  utilisateursup_id                                    Int?
  lien_meeting                                         String?      @db.VarChar(255)
  plateforme                                           String?      @db.VarChar(100)
  duree                                                Int?
  supprime                                             Boolean?
  utilisateur_entretien_utilisateurrh_idToutilisateur  Utilisateur  @relation("entretien_utilisateurrh_idToutilisateur", fields: [utilisateurrh_id], references: [id], onUpdate: Restrict, map: "fk_entretie_reference_rh")
  utilisateur_entretien_utilisateursup_idToutilisateur Utilisateur? @relation("entretien_utilisateursup_idToutilisateur", fields: [utilisateursup_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_entretie_reference_superviseur")
  candidature                                          Candidature  @relation(fields: [id_candidature], references: [id], onUpdate: Restrict, map: "fk_entretien_candidature")

  @@map("entretien")
}

model Emploi {
  id             Int          @id(map: "pk_emploi") @default(autoincrement())
  date_debut     DateTime     @db.Date
  date_fin       DateTime     @db.Date
  sujet          String       @db.VarChar(200)
  lieu           String       @db.VarChar(100)
  statut         String       @db.VarChar(50)
  id_departement Int
  can_id         Int
  supprime       Boolean?
  departement    Departement  @relation(fields: [id_departement], references: [id], onUpdate: Restrict, map: "fk_emploi_departement")
  candidature    Candidature  @relation(fields: [can_id], references: [id], onUpdate: Restrict, map: "fk_emploi_reference_candidat")
  evaluations    Evaluation[]

  @@map("emploi")
}

model Evaluation {
  id                Int         @id(map: "pk_evaluation") @default(autoincrement())
  note              Int?
  fichier_rapport   String      @db.VarChar(255)
  id_emploi         Int
  utilisateursup_id Int
  statut            Boolean
  supprime          Boolean?
  utilisateur       Utilisateur @relation(fields: [utilisateursup_id], references: [id], onUpdate: Restrict, map: "fk_evaluati_reference_utilisat")
  emploi            Emploi      @relation(fields: [id_emploi], references: [id], onUpdate: Restrict, map: "fk_evaluation_emploi")

  @@map("evaluation")
}

model droit {
  id           Int            @id(map: "pk_droit") @default(autoincrement())
  nom          String         @db.VarChar(100)
  description  String
  statut       Boolean
  supprime     Boolean?
  profil_droit profil_droit[]
}

model fichier {
  id             Int         @id(map: "pk_fichier") @default(autoincrement())
  libelle        String      @db.VarChar(50)
  chemin         String      @db.VarChar(500)
  extension      String      @db.VarChar(5)
  id_candidature Int
  supprime       Boolean?
  candidature    Candidature @relation(fields: [id_candidature], references: [id], onUpdate: Restrict, map: "fk_fichier_reference_candidat")
}

model profil {
  id_profil          Int                  @id(map: "pk_utilisateur_droits") @default(autoincrement())
  nom_profil         String               @db.VarChar(50)
  supprime           Boolean?
  profil_droit       profil_droit[]
  utilisateur_profil utilisateur_profil[]
}

model profil_droit {
  pro_id_profil Int
  id_droit      Int
  droit         droit  @relation(fields: [id_droit], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profil        profil @relation(fields: [pro_id_profil], references: [id_profil], onDelete: NoAction, onUpdate: NoAction)

  @@id([pro_id_profil, id_droit])
}

model notification {
  id             Int         @id @default(autoincrement())
  titre          String      @db.VarChar(150)
  contenu        String
  type           String?     @db.VarChar(50)
  lu             Boolean?    @default(false)
  date_envoi     DateTime?   @default(now()) @db.Timestamp(6)
  id_utilisateur Int
  supprime       Boolean?    @default(false)
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_utilisateur")
}

model utilisateur_profil {
  id_utilisateur Int
  id_profil      Int
  profil         profil      @relation(fields: [id_profil], references: [id_profil], onDelete: Cascade, onUpdate: NoAction, map: "fk_up_profil")
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_up_utilisateur")

  @@id([id_utilisateur, id_profil])
}

model historique_statut {
  id              Int          @id @default(autoincrement())
  id_candidature  Int
  ancien_statut   String?      @db.VarChar(50)
  nouveau_statut  String       @db.VarChar(50)
  date_changement DateTime     @default(now()) @db.Timestamp(6)
  id_auteur       Int?
  utilisateur     Utilisateur? @relation(fields: [id_auteur], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidature     Candidature  @relation(fields: [id_candidature], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model favori {
  id             Int         @id @default(autoincrement())
  id_utilisateur Int
  id_offre       Int
  date_ajout     DateTime    @default(now()) @db.Timestamp(6)
  offre          Offre       @relation(fields: [id_offre], references: [id], onDelete: Cascade, onUpdate: NoAction)
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_utilisateur, id_offre])
}
